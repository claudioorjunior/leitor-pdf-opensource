<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Assinatura ad-hoc local: cada binário tem identidade própria, então o
       hardened runtime rejeitaria a libpdfium em Frameworks (Library
       Validation: Team IDs diferentes). Necessário para o .app local;
       build de distribuição com Developer ID dispensa. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
